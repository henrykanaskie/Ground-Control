#!/usr/bin/env bash
# Ground Control launcher — starts the dashboard and opens it in the browser.
#
#   ground-control                      watch the default root (~/coding_projects)
#   ground-control ~/other/projects     watch a different folder
#   ground-control --port 8080          use a different port
#   ground-control --no-open            don't launch the browser
#   ground-control --app                open GroundControl.app, the macOS application, instead
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ARGS=(); OPEN="--open"

while [ $# -gt 0 ]; do
  case "$1" in
    --no-open) OPEN=""; shift ;;
    --app)
      # Hand off to the macOS application, which runs its own server on its
      # own free port. Built by ./build-app.sh.
      for app in "$HOME/Applications/GroundControl.app" "$HERE/GroundControl.app"; do
        if [ -d "$app" ]; then exec open "$app"; fi
      done
      echo "ground-control: GroundControl.app has not been built — run ./build-app.sh --install" >&2
      exit 1 ;;
    --port|-p) ARGS+=(--port "$2"); shift 2 ;;
    --root)    ARGS+=(--root "$2"); shift 2 ;;
    -h|--help)
      sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    -*) ARGS+=("$1"); shift ;;
    *)  ARGS+=(--root "$1"); shift ;;
  esac
done

command -v node >/dev/null 2>&1 || { echo "ground-control: node is required but not on PATH" >&2; exit 1; }
exec node "$HERE/server.js" ${OPEN:+$OPEN} "${ARGS[@]+"${ARGS[@]}"}"
